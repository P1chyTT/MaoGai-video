{
  "scene08": [
    {"text":"小林以为，只要把剪纸做成爆款，","startMs":1200,"endMs":5100,"timestampMs":null,"confidence":null},
    {"text":"就能证明它的价值。","startMs":5100,"endMs":8500,"timestampMs":null,"confidence":null}
  ],
  "scene09": [
    {"text":"这剪纸挺好包装的。","startMs":3000,"endMs":5600,"timestampMs":null,"confidence":null},
    {"text":"我们给它加滤镜、加配乐、加网红话术，","startMs":5600,"endMs":10100,"timestampMs":null,"confidence":null},
    {"text":"卖9.9元包邮，量大了肯定赚钱。","startMs":10100,"endMs":14600,"timestampMs":null,"confidence":null}
  ],
  "scene10": [
    {"text":"一张红纸，一把剪刀，","startMs":1700,"endMs":4100,"timestampMs":null,"confidence":null},
    {"text":"要静心剪出来。","startMs":4100,"endMs":6700,"timestampMs":null,"confidence":null},
    {"text":"9.9包邮，那不是把手艺当便宜货吗？","startMs":7000,"endMs":11700,"timestampMs":null,"confidence":null}
  ],
  "scene11": [
    {"text":"您能不能别总说这些？","startMs":1500,"endMs":4000,"timestampMs":null,"confidence":null},
    {"text":"有了销量，才有更多人知道剪纸！","startMs":4000,"endMs":8100,"timestampMs":null,"confidence":null}
  ],
  "scene12": [
    {"text":"为了火，把剪纸变成贴纸、","startMs":3000,"endMs":5600,"timestampMs":null,"confidence":null},
    {"text":"变成挂件、变成一句顺口溜，","startMs":5600,"endMs":9000,"timestampMs":null,"confidence":null},
    {"text":"那传下去的还是剪纸吗？","startMs":10500,"endMs":13800,"timestampMs":null,"confidence":null}
  ]
